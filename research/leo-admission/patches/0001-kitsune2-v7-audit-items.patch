+    /// A receiver whose clock is ahead of the sender's must still count an
+    /// intent for its full lifetime: if it read the sender's absolute
+    /// expiry it would drop the intent at once and count a departing node
+    /// as staying. The relative TTL is what protects that; the legacy
+    /// absolute expiry (TTL zero) keeps its old behaviour.
+    #[test]
+    fn relative_ttl_survives_receiver_clock_ahead_of_sender() {
+        let peer = Url::from_str("ws://127.0.0.1:80").unwrap();
+        let now = Timestamp::now();
+        // The sender's clock reads five minutes behind ours.
+        let sender_expiry = (now - Duration::from_secs(300)).unwrap();
+        let msg = |id: &'static [u8], ttl_us, withdrawn| {
+            K2ShardingShrinkIntentMessage {
+                agent_id: bytes::Bytes::from_static(id),
+                vacate_start: 0,
+                vacate_end: 8 * SECTOR_SIZE - 1,
+                expires_at_us: sender_expiry.as_micros(),
+                withdrawn,
+                grow: false,
+                ttl_us,
+            }
+        };
+        let (shrinks, grows) = (IntentTable::default(), IntentTable::default());
+        receive_intent(
+            &shrinks,
+            &grows,
+            peer.clone(),
+            msg(b"new", 30_000_000, false),
+        );
+        receive_intent(&shrinks, &grows, peer.clone(), msg(b"old", 0, false));
+        let live = |t: &IntentTable| {
+            t.live(now).into_iter().map(|(a, _)| a).collect::<Vec<_>>()
+        };
+        // Only the sender with a relative TTL is counted.
+        assert_eq!(live(&shrinks), vec![agent(b"new")]);
+        // It lapses after its TTL, by our clock, and not before.
+        assert!(!shrinks.live(now + Duration::from_secs(29)).is_empty());
+        assert!(shrinks.live(now + Duration::from_secs(31)).is_empty());
+        // A withdrawal still finds it by the sender's expiry.
+        receive_intent(&shrinks, &grows, peer.clone(), msg(b"new", 0, false));
+        receive_intent(
+            &shrinks,
+            &grows,
+            peer.clone(),
+            msg(b"new", 30_000_000, false),
+        );
+        receive_intent(&shrinks, &grows, peer, msg(b"new", 0, true));
+        assert!(live(&shrinks).is_empty());
+    }
+
+    /// An announcement cannot make a receiver count it for longer than the
+    /// cap, whether it claims a far-future expiry or a huge TTL.
+    #[test]
+    fn received_intent_lifetime_is_capped() {
+        let peer = Url::from_str("ws://127.0.0.1:80").unwrap();
+        let now = Timestamp::now();
+        let msg = |id: &'static [u8], expiry: Timestamp, ttl_us| {
+            K2ShardingShrinkIntentMessage {
+                agent_id: bytes::Bytes::from_static(id),
+                vacate_start: 0,
+                vacate_end: 8 * SECTOR_SIZE - 1,
+                expires_at_us: expiry.as_micros(),
+                withdrawn: false,
+                grow: false,
+                ttl_us,
+            }
+        };
+        let (shrinks, grows) = (IntentTable::default(), IntentTable::default());
+        let far = now + Duration::from_secs(10 * 365 * 24 * 3600);
+        receive_intent(&shrinks, &grows, peer.clone(), msg(b"abs", far, 0));
+        receive_intent(&shrinks, &grows, peer, msg(b"ttl", now, i64::MAX));
+        assert_eq!(shrinks.live(now).len(), 2);
+        let later = now + MAX_INTENT_TTL + Duration::from_secs(5);
+        assert!(shrinks.live(later).is_empty());
+    }
+
     /// Ranges that only touch neither overlap nor block a re-check.
     #[test]
     fn adjacent_ranges_do_not_overlap() {
