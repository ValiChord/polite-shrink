+/// Returns every agent that has announced a write behaviour, in a stable order.
+///
+/// `get_random_agent_with_write_behaviour` selects immediately from whatever has
+/// propagated by the time it is first called. Measured on Holochain 0.7.0, that is
+/// a **single** link for the first ~27s of a run, so every reader selects the same
+/// peer and some writers are never selected at all. Callers that need coverage of
+/// all writers should poll this until the expected count is visible, then choose
+/// deterministically.
+#[hdk_extern]
+fn get_agents_with_write_behaviour() -> ExternResult<Vec<AgentPubKey>> {
+    let links = get_links(
+        LinkQuery::try_new(write_agents_anchor()?, LinkTypes::AgentBehaviour)?,
+        GetStrategy::default(),
+    )?;
+    let mut agents = links
+        .into_iter()
+        .map(|l| {
+            AgentPubKey::try_from(l.target.clone()).map_err(|_| {
+                wasm_error!(WasmErrorInner::Guest(
+                    "Failed to cast to AgentPubKey".to_string()
+                ))
+            })
+        })
+        .collect::<ExternResult<Vec<AgentPubKey>>>()?;
+    // Sorted so that every reader derives the same ordering from the same set,
+    // which is what makes index-based assignment give full coverage.
+    agents.sort();
+    Ok(agents)
+}
