+/// How many write-behaviour agents a reader waits to see before selecting one.
+///
+/// Defaults to the 3 writers of this scenario's documented local shape
+/// (`zero_write:1 full_write:2`). Override when running a different mix.
+fn expected_write_agents() -> usize {
+    std::env::var("EXPECTED_WRITE_AGENTS")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(3)
+}
+
+/// Pause between writes, in milliseconds. Default 0 = unthrottled, i.e. the
+/// behaviour this scenario has today.
+///
+/// Note the sibling scenario `mixed_arc_must_get_agent_activity` DOES throttle
+/// (batches of 10 then a 5s sleep, ~2 entries/s), while this one writes flat out
+/// at ~10/s. Used here to separate load-induced propagation lag from structural
+/// lag: if a zero-arc author's visibility recovers as the rate drops, the lag was
+/// load; if it does not, it is not.
+fn write_sleep_ms() -> u64 {
+    std::env::var("WRITE_SLEEP_MS")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(0)
+}
+
+/// How long a reader waits for every expected writer to become visible before
+/// giving up and selecting from whatever it can see.
+///
+/// Default 90s: measured convergence was ~27s when it happened at all, and one
+/// run in three never reached the full set within 300s.
+fn selection_timeout_s() -> f64 {
+    std::env::var("SELECTION_TIMEOUT_S")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(90.0)
+}
